exports[`Sidebar > renders Sidebar and take a snapshop 1`] = `
<DocumentFragment>
  .c6 {
  position: fixed;
  z-index: 10;
  top: 1rem;
  display: flex;
  align-items: center;
  flex-direction: column;
  right: 0.5rem;
}

.c7 {
  z-index: 1;
  position: fixed;
  right: .5rem;
  bottom: 2.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.c3 >.cds--modal-container {
  background: #383838;
  background: #181818;
  overflow: unset;
}

.c4 >h3 {
  color: #fff;
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.5rem;
}

.c4 button svg {
  fill: #fff;
}

.c4 .giga-text {
  display: flex;
  color: #fff;
  font-size: 2.4rem;
  font-weight: bolder;
}

.c4 .giga-text span:first-child {
  font-weight: 100;
}

.c4 .cds--modal-close:hover {
  background-color: #181818;
}

.c5 {
  overflow: unset;
}

.c5 .cds--tooltip-content {
  background: #fff!important;
  color: #181818!important;
}

.c5 .cds--popover-caret {
  background: #fff;
}

.c5 .subheading {
  color: var(--text-text-primary, #161616);
  font-size: 0.875rem;
  margin-bottom: 1rem;
}

.c5 .field-wrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  width: 100%;
  margin-bottom: 1rem;
  font-family: Open Sans;
  font-size: 0.875rem;
  font-style: normal;
  font-weight: 400;
  line-height: 1.125rem;
}

.c5 .field-wrapper .text-input-container {
  display: flex;
  align-items: flex-end;
  gap: 0.625rem;
  align-self: stretch;
  width: 100%;
  margin-top: 0.5rem;
}

.c5 .field-wrapper .text-input-container .copy-button {
  background: #fff;
}

.c5 .field-wrapper .text-input-container .copy-button svg {
  fill: #181818;
}

.c5 .field-wrapper .text-input-container .side-panel-shareURL-text-and-textInput {
  width: inherit;
  height: 2.5rem;
  border-bottom: 1px solid var(--border-border-strong-01, #8D8D8D);
  background: #fff;
}

.c5 .social-share-icons {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 0.5rem;
}

.c5 .social-share-icons button {
  padding: 0;
  align-items: center;
  justify-content: center;
}

.c5 .social-share-icons .twitter-icon {
  fill: #277AFF;
}

.c5 .field-wrapper span {
  color: #fff;
  font-size: 0.875rem;
  font-weight: 400;
  line-height: 1.25rem;
}

.c5 .field-wrapper input {
  background: #474747;
  color: #fff;
  border: none;
}

.c5 .share-icons-container span {
  color: #fff;
}

.c5 .share-icons-container .social-share-icons svg {
  fill: #fff;
}

.c1 {
  display: flex;
  align-items: center;
  padding: 0.8rem 1rem 0.8rem 1rem!important;
  cursor: pointer;
  color: #181818;
}

.c1:hover {
  background: #fff!important;
}

.c1:hover .cds--side-nav__link-text {
  color: #181818!important;
  font-weight: normal;
}

.c1 >span.cds--side-nav__link-text {
  color: #fff;
  font-weight: normal;
}

.c1 >.cds--side-nav__icon {
  margin-right: 0.7rem;
}

.c1 .cds--side-nav__icon svg {
  fill: #fff;
}

.c1:hover .cds--side-nav__icon svg {
  fill: #181818;
}

.c0 {
  background: #181818;
  height: calc(100% - 3rem);
  top: 3rem;
  width: 100%;
  position: absolute;
  z-index: 13;
}

.c0 .cds--contained-list-item:not(:last-of-type)::before {
  background-color: #181818!important;
}

.c2 {
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 0.5rem 1rem;
}

.c2 .cds--list-box__field {
  background: #333333;
}

.c2 .cds--list-box__label {
  color: #c0c0c0;
}

.c2 .cds--list-box__menu-icon svg {
  fill: #fff;
}

.c2 .cds--list-box__label {
  color: #f5f5f5;
}

.c2 .cds--label {
  color: #c0c0c0;
}

.c2 .cds--list-box__menu {
  background: #333333;
}

.c2 .cds--list-box__menu-item__option {
  color: #c0c0c0;
}

.c2 .cds--list-box__menu-item--active .cds--list-box__menu-item__option {
  color: #222;
}

@media (max-width:768px) {
  .c6 {
    top: 6.5rem;
  }
}

@media (max-width:768px) {
  .c7 {
    bottom: calc(32vh + 0.5rem);
  }
}

@media (max-width:768px) {
  .c0 {
    position: fixed;
  }
}

