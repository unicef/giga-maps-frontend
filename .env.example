# ==============================================================================
# Giga Maps Frontend - Environment Variables
# ==============================================================================

# API Base URL
VITE_API_BASE_URL=https://uni-ooi-giga-maps-backend-dev.azurewebsites.net/

# Mapbox Access Token
VITE_API_MAPBOX_ACCESS_TOKEN=

# Giga Meter Host
VITE_GIGA_METER_API_HOST=https://uni-ooi-giga-meter-backend-dev.azurewebsites.net

# Airtable API Key
VITE_AIRTABLE_API_KEY=

# Azure AD B2C Client ID
VITE_B2C_CLIENT_ID=

# Matomo Analytics
VITE_MATOMO_SITE_ID=0

# ==============================================================================
# Sentry Configuration (Standards & Best Practices)
# ==============================================================================
# Project: giga-maps-frontend
# One project per deployable component. Never share DSN across components.
VITE_SENTRY_DSN=https://examplePublicKey@sentry.example.com/123

# Canonical Environments: production | staging | development | local | test
# Note: 'local' and 'test' are disabled by default unless VITE_SENTRY_DSN is set
VITE_SENTRY_ENVIRONMENT=development

# Immutable build release identifier (e.g., git commit sha or semantic tag)
VITE_SENTRY_RELEASE=giga-maps-frontend@0.0.0

# Performance Monitoring Traces Sample Rate (0.0 to 1.0)
# Recommended: 1.0 for development/staging, 0.2 for production
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# Session Replay Sample Rates (0.0 to 1.0)
VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0

# Enable/Disable Sentry toggle (defaults to true if DSN is set)
VITE_SENTRY_ENABLED=true
